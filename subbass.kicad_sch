	(text "Passa-baixas 40 Hz + subsônico 10 Hz | OPA1656 | ±15 V" (at 30.48 33.02 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "143b056e-9281-4ff5-8d6d-6b5997bc301d"))
	(text "MUTE AUTOMÁTICO: S1 passa áudio somente com CTRL_PASSA alto." (at 30.48 43.18 0) (effects (font (size 1 1)) (justify left top)) (uuid "591d721f-b699-4c90-ba8f-c25f2142fb7d"))
	(text "S1 e U4 são modelos de estudo, excluídos da PCB e da BOM. Não representam hardware final." (at 30.48 48.26 0) (effects (font (size 1 1)) (justify left top)) (uuid "2628d158-eeda-46db-827d-28bb48787834"))
